# 复制为 .env 后按需修改（.env 已被 .gitignore / .dockerignore 忽略）
PORT=3000
# 时区：影响机器人记账时使用的“今天”
TZ=Asia/Shanghai
# 可选：监听地址。留空监听所有地址；反向代理场景可设为 127.0.0.1
# HOST=127.0.0.1
# 可选：数据目录。默认是程序旁边的 data/ 目录
# LEDGER_DATA_DIR=/var/lib/ledger
# Docker 部署可选：只把端口暴露给宿主机本机（配合反向代理）
# BIND_IP=127.0.0.1

BOT_ENABLE=1
# 留空自动判断：Docker 内使用 host.docker.internal，本机使用 127.0.0.1
# 也可显式填写，例如 ws://host.docker.internal:3001 或 ws://127.0.0.1:3001
BOT_WS_URL=
# 与 OneBot 的 access_token 一致
BOT_TOKEN=replace-with-your-onebot-token

# ---- Ory Kratos 统一账号登录（可选）----
# 开启后，协会成员可用统一账号登录查看账目（只读）；管理员仍用本地账号。
# 部署要求：本系统必须能收到浏览器的 Kratos 会话 Cookie，详见 README。
# KRATOS_ENABLE=1
# 服务端访问 Kratos 的地址：Docker 同网络可用服务名；
# systemd/二进制部署用宿主机映射的本机端口。不要填经过 Cloudflare 的公网域名。
# KRATOS_PUBLIC_URL=http://127.0.0.1:4433
# 浏览器访问 Kratos 公开 API 的基地址，默认等于 PUBLIC_URL；Kratos 挂在路径前缀下时要带上前缀
# KRATOS_BROWSER_URL=https://sso.example.com
# Kratos 会话 Cookie 名，默认 ory_kratos_session
# KRATOS_SESSION_COOKIE=ory_kratos_session
# 浏览器登出路径，默认 /self-service/logout/browser（v0.6+）；
# Kratos v0.5.x 需改为 /self-service/browser/flows/logout
# KRATOS_LOGOUT_PATH=/self-service/browser/flows/logout
# 本系统对外地址，开启 Kratos 时必需，用于拼接统一登录回调（替换为实际域名）
# PUBLIC_URL=https://ledger.example.com
